{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ActivitiesDb",
    "SeedEnabled": true,
    "ServerSelectionTimeoutMS": 5000,
    "MaxPoolSize": 100
  },
  "LuckyPenny": {
    "LicenseKey": ""
  },
  "Performance": {
    "ThresholdMilliseconds": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
