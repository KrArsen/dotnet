{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "platform",
          "Version": "v1",
          "Description": "Gateway Aggregation Service"
        }
      },
      "deals": {
        "ClusterId": "sales",
        "Order": 2,
        "Match": {
          "Path": "/api/deals/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "sales",
          "Version": "v1"
        }
      },
      "clients": {
        "ClusterId": "sales",
        "Order": 2,
        "Match": {
          "Path": "/api/clients/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "sales",
          "Version": "v1"
        }
      },
      "teammembers": {
        "ClusterId": "sales",
        "Order": 2,
        "Match": {
          "Path": "/api/teammembers/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "sales",
          "Version": "v1"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "Order": 2,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Order": 2,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "categories": {
        "ClusterId": "catalog",
        "Order": 2,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "activities": {
        "ClusterId": "activities",
        "Order": 2,
        "Match": {
          "Path": "/api/activities/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "activities",
          "Version": "v1"
        }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 2,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "reviews",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "sales": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://sales-api"
          }
        }
      },
      "orders": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://orders-api"
          }
        }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "activities": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://activities-api"
          }
        }
      },
      "reviews": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://reviews-api"
          }
        }
      }
    }
  }
}
