{
  "Jwt": {
    "Issuer": "Platform.Auth.Api",
    "Audience": "Platform.Microservices",
    "SecretKey": "SuperSecretPlatformJwtSigningKey_Lab09_AtLeast32Chars!"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5005"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "payments-api-route": {
        "ClusterId": "payments-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "sales-deals-route": {
        "ClusterId": "sales-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/deals/{**catch-all}"
        }
      },
      "sales-clients-route": {
        "ClusterId": "sales-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/clients/{**catch-all}"
        }
      },
      "sales-orders-api-route": {
        "ClusterId": "sales-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "sales-orders-route": {
        "ClusterId": "sales-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "sales-team-route": {
        "ClusterId": "sales-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/team-members/{**catch-all}"
        }
      },
      "catalog-products-api-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "catalog-products-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "activities-route": {
        "ClusterId": "activities-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/activities/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "activities-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://auth-api"
          }
        }
      },
      "aggregator-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://aggregator"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://payments-api"
          }
        }
      },
      "sales-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://sales-api"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://catalog-api"
          }
        }
      },
      "activities-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://activities-api"
          }
        }
      }
    }
  }
}
